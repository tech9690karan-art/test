local function DebugShake()
    local gui = game.Players.LocalPlayer:FindFirstChild("PlayerGui")
    local shakeui = gui:FindFirstChild("shakeui")
    
    if not shakeui then
        print("❌ No shakeui found")
        return
    end
    
    print("=== SHAKE UI STRUCTURE ===")
    for _, child in pairs(shakeui:GetDescendants()) do
        print(child:GetFullName(), "-", child.ClassName)
    end
    
    print("\n=== CHECKING BUTTON ===")
    local safezone = shakeui:FindFirstChild("safezone")
    if safezone then
        local button = safezone:FindFirstChild("button")
        if button then
            print("Button ClassName:", button.ClassName)
            print("Button Visible:", button.Visible)
            
            -- Check if Activated event exists
            local success, result = pcall(function()
                return button.Activated
            end)
            print("Activated event exists:", success)
            
            -- Check all connections
            local connections = getconnections(button.Activated)
            print("Activated connections:", #connections)
        else
            print("❌ No button found")
        end
    else
        print("❌ No safezone found")
    end
    
    print("\n=== CHECKING REMOTES ===")
    local rs = game:GetService("ReplicatedStorage")
    for _, child in pairs(rs:GetDescendants()) do
        if child:IsA("RemoteEvent") and child.Name:lower():find("shake") then
            print("FOUND:", child:GetFullName())
        end
    end
end

DebugShake()
