local function sendToDiscord(userId, userName, gameId, gameName, status, errorMsg, loaderCount, gameCount)
    pcall(function()
        local http = game:GetService("HttpService")
        
        local embed = {
            {
                title = "📊 Script Execution Report",
                color = status == "success" and 3066993 or (status == "error" and 15158332 or 15844367),
                fields = {
                    {
                        name = "👤 User",
                        value = string.format("**%s** (`%s`)", userName, userId),
                        inline = true
                    },
                    {
                        name = "🎮 Game",
                        value = string.format("**%s**", gameName),
                        inline = true
                    },
                    {
                        name = "📌 Status",
                        value = status == "success" and "✅ **SUCCESS**" or (status == "error" and "❌ **ERROR**" or "⚠️ **UNSUPPORTED**"),
                        inline = true
                    },
                    {
                        name = "🆔 Game ID",
                        value = string.format("`%s`", gameId),
                        inline = true
                    },
                    {
                        name = "📅 Time",
                        value = os.date("%Y-%m-%d %H:%M:%S"),
                        inline = true
                    },
                    {
                        name = "🏷️ Place ID",
                        value = string.format("`%s`", game.PlaceId),
                        inline = true
                    },
                    {
                        name = "📊 Loader Executions",
                        value = string.format("`%s`", loaderCount),
                        inline = true
                    },
                    {
                        name = "🎮 Game Executions",
                        value = string.format("`%s` (%s)", gameCount, gameName),
                        inline = true
                    }
                },
                footer = {
                    text = "Universal Script Loader"
                },
                timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ")
            }
        }
        
        if errorMsg then
            table.insert(embed[1].fields, {
                name = "⚠️ Error Details",
                value = string.format("```lua\n%s\n```", errorMsg),
                inline = false
            })
        end
        
        local payload = {
            embeds = embed
        }
        
        http:PostAsync(WEBHOOK_URL, http:JSONEncode(payload))
    end)
end

--[[ Logic ]]
local id = game.GameId
local notifId = game.PlaceId
local scriptUrl = games[id]
local gameName = "Unknown"
local userId = "Unknown"
local userName = "Unknown"

-- Increment total loader executions
stats.totalLoaderExecutions = (stats.totalLoaderExecutions or 0) + 1

-- Get user data with pcall
pcall(function()
    local player = game:GetService("Players").LocalPlayer
    if player then
        userId = tostring(player.UserId)
        userName = player.Name
    end
end)

-- Get game name with pcall
pcall(function()
    gameName = game:GetService("MarketplaceService"):GetProductInfo(notifId).Name
end)

if scriptUrl then
    notify("STATUS:", "Detected game: " .. gameName)
    
    -- Increment game-specific execution count
    local gameIdStr = tostring(id)
    stats.gameExecutions[gameIdStr] = (stats.gameExecutions[gameIdStr] or 0) + 1
    
    -- Save stats
    pcall(function()
        if shared then
            shared.stats = stats
        end
    end)
    
    local success, err = pcall(function()
        loadstring(game:HttpGet(scriptUrl))()
    end)

    if success then
        notify("STATUS:", "Loaded successfully!")
        pcall(function()
            sendToDiscord(
                userId, 
                userName, 
                id, 
                gameName, 
                "success", 
                nil,
                stats.totalLoaderExecutions,
                stats.gameExecutions[gameIdStr]
            )
        end)
    else
        notify("STATUS:", "Error loading script!")
        pcall(function()
            sendToDiscord(
                userId, 
                userName, 
                id, 
                gameName, 
                "error", 
                tostring(err),
                stats.totalLoaderExecutions,
                stats.gameExecutions[gameIdStr]
            )
        end)
    end
else
    notify("STATUS:", "Game not supported!")
    pcall(function()
        sendToDiscord(
            userId, 
            userName, 
            id, 
            gameName, 
            "unsupported", 
            nil,
            stats.totalLoaderExecutions,
            0
        )
    end)
end
